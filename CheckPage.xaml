<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CashPlace.CheckPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CashPlace"
             x:Name="rootPage"
             Title="Чек">
             
    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto, Auto">

        <!-- ★ ЖЕСТЫ РЕЖИМОВ: свайп справа налево — предпросмотр оплаты (режим «ОПЛАТА»),
             свайп слева направо — возврат к набивке,
             свайп ВВЕРХ или ВНИЗ — ввод акционного штрихкода (аналог F5 десктопа; работает вне списка
             товаров, чтобы не спорить с прокруткой). Дублируется кнопкой «★ ШК АКЦИИ». ★ -->
        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Left" Swiped="OnSwipeToPaymentPreview"/>
            <SwipeGestureRecognizer Direction="Right" Swiped="OnSwipeBackToComposition"/>
            <SwipeGestureRecognizer Direction="Down" Swiped="OnSwipePromoBarcode"/>
            <SwipeGestureRecognizer Direction="Up" Swiped="OnSwipePromoBarcode"/>
        </Grid.GestureRecognizers>

        <!-- 1. Верхняя панель: при набивке — синяя «Касса №…», в предпросмотре — зелёная «ОПЛАТА» -->
        <Grid x:Name="TopBar" Grid.Row="0" ColumnDefinitions="*, *, *" Padding="10" BackgroundColor="#FF007ACC">
            <Label Grid.Column="0" x:Name="NumCashLabel" TextColor="White" FontAttributes="Bold"/>
            <Label Grid.Column="1" x:Name="DateTimeLabel" TextColor="White" HorizontalOptions="Center"/>
            <Label Grid.Column="2" x:Name="UserLabel" TextColor="White" HorizontalOptions="End"/>
            <!-- ★ режим предпросмотра: большая надпись ОПЛАТА вместо служебных полей ★ -->
            <Label Grid.Column="0" Grid.ColumnSpan="3" x:Name="PayModeLabel" Text="ОПЛАТА"
                   IsVisible="False" TextColor="White" FontSize="26" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <!-- 2. Поле поиска товара, кнопка сканера и карта клиента — только при набивке -->
        <HorizontalStackLayout x:Name="SearchRow" Grid.Row="1" Spacing="10" Margin="10">
            <Entry x:Name="SearchProductEntry" 
                   Placeholder="Отсканируйте штрихкод или код" 
                   Keyboard="Numeric"
                   ReturnType="Done"
                   Completed="SearchProductEntry_Completed"
                   WidthRequest="280"/>

            <Button x:Name="ScanBtn" 
                    Text="📷" 
                    Clicked="OnScanClicked" 
                    WidthRequest="60" 
                    HeightRequest="50" 
                    VerticalOptions="Center" />

            <!-- ★ КАРТА КЛИЕНТА ★ -->
            <Entry x:Name="ClientEntry" 
                   Placeholder="Карта клиента (телефон/код)" 
                   Keyboard="Numeric"
                   ReturnType="Done"
                   Completed="ClientEntry_Completed"
                   WidthRequest="240"/>

            <!-- имя клиента (зелёная строка) — просто индикатор найденного клиента -->
            <Label x:Name="ClientLabel" Text=""
                   TextColor="DarkGreen" FontAttributes="Bold" FontSize="14"
                   VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- 2. Список товаров.
             ★ Акционная кнопка «★ ШК АКЦИИ» переехала ВНИЗ, в ряд вида оплаты (справа от ✎).
             Введённые ШК дают ПРИОРИТЕТную сработку акций (kind=1 считается первыми),
             список живёт до конца чека и переживает переходы в окно оплаты и обратно. -->
        <CollectionView Grid.Row="2" x:Name="ProductsCollectionView" 
                        ItemsSource="{Binding ProductsList}" 
                        SelectionMode="None"
                        Margin="5">
            <CollectionView.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Left" Swiped="OnSwipeToPaymentPreview"/>
                <SwipeGestureRecognizer Direction="Right" Swiped="OnSwipeBackToComposition"/>
            </CollectionView.GestureRecognizers>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:ProductItem">
                    <Frame Margin="5" Padding="10" BorderColor="LightGray" HasShadow="False">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">

                            <!-- ★ наименование — теперь на ВСЮ ширину карточки, перенос по словам ★ -->
                            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Tovar}" FontSize="16"
                                   FontAttributes="Bold" LineBreakMode="WordWrap"/>

                            <!-- ★ СУММА — уехала вниз, на строку с кнопками, справа (выравнивание прежнее) ★ -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="0"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding SumFull, StringFormat='{0:F2} ₽'}" FontSize="12"
                                       TextColor="Gray" TextDecorations="Strikethrough"
                                       HorizontalOptions="End" IsVisible="{Binding HasDiscount}"/>
                                <Label Text="{Binding SumAtDiscount, StringFormat='{0:F2} ₽'}" FontSize="18"
                                       FontAttributes="Bold" TextColor="DarkBlue" HorizontalOptions="End"/>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="10" Margin="0,5,0,0"
                                                   VerticalOptions="Center">
                                <Button Text="-" WidthRequest="40" Clicked="OnDecreaseQuantity"
                                        BindingContext="{Binding}" IsEnabled="{Binding IsEditable, Source={x:Reference rootPage}}"/>
                                <Label Text="{Binding Quantity, StringFormat='Кол-во: {0}'}" VerticalOptions="Center" FontSize="14"/>
                                <Button Text="+" WidthRequest="40" Clicked="OnIncreaseQuantity"
                                        BindingContext="{Binding}" IsEnabled="{Binding IsEditable, Source={x:Reference rootPage}}"/>
                                <Button Text="✕" WidthRequest="40" CornerRadius="8"
                                        BackgroundColor="#FFEBEE" TextColor="#C62828" FontAttributes="Bold"
                                        Clicked="OnDeleteProduct"
                                        BindingContext="{Binding}" IsEnabled="{Binding IsEditable, Source={x:Reference rootPage}}"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="6"
                                                   HorizontalOptions="End" VerticalOptions="Center">
                                <Label Text="{Binding Price, StringFormat='{0:F2} ₽'}" FontSize="12"
                                       TextColor="Gray" TextDecorations="Strikethrough"
                                       VerticalOptions="Center" IsVisible="{Binding HasDiscount}"/>
                                <Label Text="{Binding PriceAtDiscount, StringFormat='Цена: {0:F2} ₽/шт'}"
                                       FontSize="14" TextColor="DarkGray"/>
                            </HorizontalStackLayout>

                            <!-- ★ комментарий акции (почему изменилась цена); пустой — не отображается ★ -->
                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding PromoDescription}"
                                   FontSize="12" FontAttributes="Italic"
                                   TextColor="#E65100" LineBreakMode="WordWrap"
                                   VerticalOptions="End"/>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 3. Общая сумма; в предпросмотре — «К ОПЛАТЕ» + строка про скидку покупателя -->
        <Grid Grid.Row="3" RowDefinitions="Auto, Auto" RowSpacing="2" Padding="15,8" BackgroundColor="LightGray">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" x:Name="TotalCaptionLabel" Text="ИТОГО:" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label Grid.Column="1" x:Name="TotalSumLabel" Text="0.00 ₽" FontSize="24" FontAttributes="Bold" TextColor="DarkGreen"/>
            </Grid>
            <Label Grid.Row="1" x:Name="DiscountInfoLabel" IsVisible="False" FontSize="13" FontAttributes="Italic"
                   TextColor="#E65100" HorizontalOptions="End"/>
        </Grid>

        <!-- 4. ВИД ОПЛАТЫ: наличные / QR + комментарий + ★ акционный штрихкод (аналог F5 десктопа) -->
        <VerticalStackLayout Grid.Row="4" Spacing="4" Margin="10,5">
            <HorizontalStackLayout x:Name="PayTypeLayout" 
                                   Spacing="10" HorizontalOptions="Center">
                <Button x:Name="PayTypeCashBtn" Text="Наличные" Clicked="OnPayTypeCash"
                        WidthRequest="140" HeightRequest="45" CornerRadius="10"
                        FontSize="16" FontAttributes="Bold"/>
                <Button x:Name="PayTypeQrBtn" Text="QR-код" Clicked="OnPayTypeQr"
                        WidthRequest="140" HeightRequest="45" CornerRadius="10"
                        FontSize="16" FontAttributes="Bold"/>
                <!-- ★ комментарий кассира (комментарий + номера купюр) → checks_header.comment ★ -->
                <Button x:Name="CommentBtn" Text="✎" Clicked="OnCommentButtonClicked"
                        WidthRequest="60" HeightRequest="45" CornerRadius="10"
                        FontSize="18" BackgroundColor="#FF9E9E9E" TextColor="White"/>
                <!-- ★ акционный штрихкод: справа от карандаша; ввод также по свайпу вверх/вниз ★ -->
                <Button x:Name="PromoBarcodeBtn" Text="★ ШК АКЦИИ" Clicked="OnPromoBarcodeClicked"
                        WidthRequest="130" HeightRequest="45" CornerRadius="10"
                        FontSize="14" FontAttributes="Bold"
                        BackgroundColor="#E65100" TextColor="White"/>
            </HorizontalStackLayout>

            <!-- ★ введённые акционные ШК; виден в т.ч. в окне оплаты — список переживает переход ★ -->
            <Label x:Name="PromoBarcodesLabel" Text="" IsVisible="False"
                   TextColor="#E65100" FontSize="13" FontAttributes="Italic"
                   LineBreakMode="WordWrap" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" Margin="10,0"/>

            <!-- ★ текущий комментарий чека; в старом чеке — загруженный из БД ★ -->
            <Label x:Name="CommentLabel" Text="" IsVisible="False"
                   TextColor="#E65100" FontSize="13" FontAttributes="Italic"
                   LineBreakMode="WordWrap" MaxLines="2" Margin="10,0"/>
        </VerticalStackLayout>

        <!-- 5. Подсказка режима + ПЕРЕЙТИ К ОПЛАТЕ / СОЗДАТЬ ЧЕК + удаление чека -->
        <Grid Grid.Row="5" RowDefinitions="Auto, Auto" RowSpacing="4" Padding="10,0,10,10">
            <Label Grid.Row="0" x:Name="ModeHintLabel" IsVisible="False" FontSize="12" FontAttributes="Italic"
                   TextColor="Gray" HorizontalOptions="Center"/>
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
            <Button x:Name="PayButton" Text="ПЕРЕЙТИ К ОПЛАТЕ →" 
                    BackgroundColor="#FF2196F3" TextColor="White" 
                    FontSize="20" FontAttributes="Bold" 
                    HeightRequest="60"
                    Clicked="PayButton_Clicked"/>
            <Button x:Name="DeleteCheckButton" Grid.Column="1"
                    Text="🗑" 
                    BackgroundColor="#F44336" TextColor="White"
                    FontSize="22"
                    WidthRequest="60" HeightRequest="60" CornerRadius="8"
                    Margin="10,0,0,0"
                    Clicked="OnDeleteCheckClicked"
                    IsEnabled="{Binding IsNewCheck, Source={x:Reference rootPage}}"/>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
