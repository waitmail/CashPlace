<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CashPlace.ChecksPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CashPlace"
             Title="Чеки"
             BackgroundColor="#F2F4F7">

    <!-- КОРЕНЬ: ровно 4 строки. У КАЖДОГО блока свой Grid.Row, номер = позиция.
         0 = панель даты, 1 = список чеков, 2 = полоса ИТОГО, 3 = кнопка НОВЫЙ ЧЕК.
         Если Grid.Row не указан — элемент попадает в строку 0 и ляжет поверх даты! -->
    <Grid RowDefinitions="Auto, *, Auto, Auto" Padding="10" RowSpacing="6">

        <!-- СТРОКА 0: панель даты + кнопка обновления + ограничитель «3 последних».
             Контролы лежат на БЕЛЫХ «таблетках», чтобы не сливаться с синей полосой.
             Обработчики — из вашего code-behind: OnRefreshClicked и checkBox.IsChecked.
             DateSelected НЕ вешаем — этого обработчика в code-behind нет:
             смена даты применяется по кнопке ⟳ (как в вашей старой версии). -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="6"
              Padding="10,8" BackgroundColor="#FF007ACC">
            <Label Grid.Column="0" Text="Дата:" TextColor="White"
                   FontAttributes="Bold" FontSize="15" VerticalOptions="Center" Margin="4,0,0,0"/>

            <!-- Пикер даты: белая «таблетка», тёмный текст -->
            <Frame Grid.Column="1" BackgroundColor="White" CornerRadius="20"
                   Padding="12,6" HasShadow="False" BorderColor="Transparent"
                   VerticalOptions="Center" Margin="2,0">
                <DatePicker x:Name="datePicker" Format="dd.MM.yyyy"
                            TextColor="#0D47A1" BackgroundColor="Transparent"/>
            </Frame>

            <!-- ⟳: белый круг, синяя стрелка -->
            <Button Grid.Column="2" Text="⟳" Clicked="OnRefreshClicked"
                    BackgroundColor="White" TextColor="#007ACC"
                    WidthRequest="40" HeightRequest="40" CornerRadius="20"
                    Padding="0" FontSize="18" VerticalOptions="Center" Margin="2,0"/>

            <!-- Чекбокс: белая «таблетка», тёмная подпись -->
            <Frame Grid.Column="3" BackgroundColor="White" CornerRadius="20"
                   Padding="12,6" HasShadow="False" BorderColor="Transparent"
                   VerticalOptions="Center" Margin="2,0">
                <HorizontalStackLayout Spacing="8">
                    <CheckBox x:Name="checkBox_show_3_last_checks" IsChecked="True"
                              VerticalOptions="Center"/>
                    <Label Text="3 последних" TextColor="#0D47A1" FontSize="13"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Frame>
        </Grid>

        <!-- СТРОКА 1: список чеков (сколько показывать — решает чекбокс «3 последних» в code-behind) -->
        <CollectionView Grid.Row="1" x:Name="ChecksCollectionView"
                        ItemsSource="{Binding CheckItems}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:CheckItem">
                    <Frame Margin="0,3" Padding="12" CornerRadius="12"
                           BorderColor="#E0E0E0" HasShadow="False" BackgroundColor="White">
                        <Frame.GestureRecognizers>
                            <!-- ★ тап по карточке открывает чек — ваш обработчик OnCheckItemTapped ★ -->
                            <TapGestureRecognizer Tapped="OnCheckItemTapped" NumberOfTapsRequired="1"/>
                        </Frame.GestureRecognizers>
                        <Grid RowDefinitions="Auto, Auto, Auto, Auto"
                              ColumnDefinitions="*, Auto" RowSpacing="4">

                            <!-- Строка 0: номер документа + тип чека -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding DocumentNumber}"
                                   FontSize="16" FontAttributes="Bold"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CheckType}"
                                   FontSize="13" TextColor="#757575"/>

                            <!-- Строка 1: клиент + сумма (у удалённого — красная зачёркнутая) -->
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding ClientName}"
                                   FontSize="14" TextColor="DarkGreen"
                                   LineBreakMode="TailTruncation"/>
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding FormattedCash}"
                                   FontSize="16" FontAttributes="Bold"
                                   HorizontalOptions="End">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsDeleted}" Value="True">
                                        <Setter Property="TextColor" Value="#C62828"/>
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- Строка 2: дата + бейджи «Удалён» / «Выгружено» -->
                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding FormattedDate}"
                                   FontSize="12" TextColor="#9E9E9E"/>
                            <HorizontalStackLayout Grid.Row="2" Grid.Column="1"
                                                   Spacing="6" HorizontalOptions="End">
                                <Label Text="✕ Удалён" FontSize="11" Padding="6,2"
                                       TextColor="#C62828" BackgroundColor="#FFEBEE" IsVisible="False">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsDeleted}" Value="True">
                                            <Setter Property="IsVisible" Value="True"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="✓ Выгружено" FontSize="11" Padding="6,2"
                                       TextColor="#2E7D32" BackgroundColor="#E8F5E9" IsVisible="False">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSent}" Value="True">
                                            <Setter Property="IsVisible" Value="True"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>

                            <!-- Строка 3: комментарий кассира (checks_header.comment), пустой — скрыт -->
                            <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding Comment}" IsVisible="False"
                                   FontSize="12" FontAttributes="Italic" TextColor="#E65100"
                                   LineBreakMode="WordWrap" MaxLines="2">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding HasComment}" Value="True">
                                        <Setter Property="IsVisible" Value="True"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Надпись «нет данных»: текстом и видимостью управляет ваш code-behind
             (NoDataLabel.IsVisible / NoDataLabel.Text).
             Лежит в той же строке 1, что и список — это НАМЕРЕННО: когда список пуст,
             метка видна поверх пустой области. -->
        <Label x:Name="NoDataLabel" Grid.Row="1"
               Text="Нет чеков за выбранную дату"
               IsVisible="False" TextColor="#9E9E9E" FontSize="15"
               HorizontalOptions="Center" VerticalOptions="Center"/>

        <!-- СТРОКА 2: полоса ИТОГО за день -->
        <Grid Grid.Row="2" BackgroundColor="#E3F2FD" Padding="12,8"
              ColumnDefinitions="Auto, Auto, *" ColumnSpacing="16">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label x:Name="TotalsCashLabel" Text="Наличные: 0 ₽" FontSize="14"/>
                <Label x:Name="TotalsQrLabel" Text="QR: 0 ₽" FontSize="14"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label x:Name="TotalsTotalLabel" Text="Итого: 0 ₽"
                       FontSize="14" FontAttributes="Bold"/>
                <Label x:Name="TotalsCountLabel" Text="Чеков: 0"
                       FontSize="14" TextColor="#455A64"/>
            </VerticalStackLayout>
            <Label x:Name="TotalsDeletedLabel" Grid.Column="2" Text=""
                   FontSize="12" TextColor="#C62828"
                   HorizontalTextAlignment="End" VerticalOptions="Center"
                   LineBreakMode="WordWrap"/>
        </Grid>

        <!-- СТРОКА 3: кнопки «Проверка акций» (аналог десктопного btn_check_actions)
             и нового чека — ширина делится ПОПОЛАМ (1:1). -->
        <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="8">
            <!-- ★ Проверка акций: черновой подбор товаров без записи чека ★ -->
            <Button Grid.Column="0" x:Name="VerifyActionsButton"
                    Text="🔍  ПРОВЕРКА АКЦИЙ"
                    Clicked="OnVerifyActionsClicked"
                    BackgroundColor="#FF9C27B0" TextColor="White"
                    FontSize="16" FontAttributes="Bold"
                    HeightRequest="60" CornerRadius="10"/>
            <Button Grid.Column="1" x:Name="NewCheckButton"
                    Text="＋  НОВЫЙ ЧЕК"
                    Clicked="OnNewCheckClicked"
                    BackgroundColor="#FF2196F3" TextColor="White"
                    FontSize="20" FontAttributes="Bold"
                    HeightRequest="60" CornerRadius="10"/>
        </Grid>

    </Grid>
</ContentPage>
