<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- ? Îñòàâëåíû òîëüêî Android è Windows -->
        <TargetFrameworks>net8.0-android;net8.0-windows10.0.19041.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>CashPlace</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
		
		 <!-- ? Ïóòü ê Android SDK -->
        <AndroidSdkDirectory>C:\Users\User\AppData\Local\Android\Sdk</AndroidSdkDirectory>
        
        <!-- ? Ïóòü ê Java JDK -->
        <JavaSdkDirectory>D:\Program Files\Android\Android Studio\jbr</JavaSdkDirectory>

        <!-- ? ÏÐÈÍÈÌÀÅÌ ËÈÖÅÍÇÈÈ ANDROID -->
        <AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>


        <!-- Display name -->
        <ApplicationTitle>CashPlace</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.yourname.cash8mobile</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0.100</ApplicationDisplayVersion>
        <ApplicationVersion>100</ApplicationVersion>

        <!-- Ìèíèìàëüíûå âåðñèè ïëàòôîðì -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4"/>

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128"/>

        <!-- Images -->
        <MauiImage Include="Resources\Images\*"/>
        <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185"/>

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*"/>

        <!-- Raw Assets -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>	

	<ItemGroup Condition="$(TargetFramework.Contains('-android'))">
		<AndroidLibrary Remove="Platforms\Android\Jars\libfptr10.aar" />
		<AndroidLibrary Include="Platforms\Android\Jars\libfptr10.aar" Bind="true" />
		<TransformFile Include="Transforms\Metadata.xml" />
	</ItemGroup>




    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-preview.5.26302.115" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.4.0" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Platforms\Android\xml\file_paths.xml" />
      <AndroidResource Include="Platforms\Android\xml\file_paths.xml" />
    </ItemGroup>

</Project>






































































